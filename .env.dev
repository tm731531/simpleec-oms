# SimpleEC OMS - Development Environment Variables

# ============ Database ============
DB_HOST=postgres
DB_PORT=5432
DB_NAME=simpleec
DB_USER=simpleec
DB_PASSWORD=simpleec123
DB_MAX_CONNECTIONS=200

# ============ Redis ============
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TIMEOUT=2000
REDIS_MAX_IDLE=8
REDIS_MAX_ACTIVE=16

# ============ Kafka ============
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_AUTO_CREATE_TOPICS_ENABLE=false
KAFKA_LOG_RETENTION_HOURS=-1
KAFKA_NUM_PARTITIONS=8

# ============ Application ============
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,prometheus,info,metrics
MANAGEMENT_ENDPOINTS_WEB_BASE_PATH=/actuator
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_COM_SIMPLEEC=DEBUG

# ============ Data ============
DATA_DIR=./data

# ============ Development ============
DEBUG=false
GRADLE_BUILD_TYPE=dev
