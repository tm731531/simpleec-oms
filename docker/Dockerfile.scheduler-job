FROM eclipse-temurin:17-jdk-alpine AS builder
WORKDIR /build
COPY gradle gradle
COPY gradlew .
COPY build.gradle settings.gradle ./
COPY simpleec-common simpleec-common
COPY simpleec-scheduler-job simpleec-scheduler-job
RUN chmod +x gradlew && ./gradlew :simpleec-scheduler-job:bootJar -x test --no-daemon

FROM eclipse-temurin:17-jre-alpine
WORKDIR /app
ADD https://github.com/open-telemetry/opentelemetry-java-instrumentation/releases/download/v2.10.0/opentelemetry-javaagent.jar /app/otel-agent.jar
COPY --from=builder /build/simpleec-scheduler-job/build/libs/simpleec-scheduler-job-1.0.0.jar app.jar
ENV SPRING_PROFILES_ACTIVE=docker
ENTRYPOINT ["java", \
  "-javaagent:/app/otel-agent.jar", \
  "-Dspring.redis.host=redis", \
  "-Dspring.redis.port=6379", \
  "-Dspring.kafka.bootstrap-servers=kafka:9092", \
  "-Dspring.kafka.producer.bootstrap-servers=kafka:9092", \
  "-Dspring.kafka.consumer.bootstrap-servers=kafka:9092", \
  "-jar", "app.jar"]
