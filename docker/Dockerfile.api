FROM eclipse-temurin:17-jdk-alpine AS builder
WORKDIR /build
COPY gradle gradle
COPY gradlew .
COPY build.gradle settings.gradle ./
COPY simpleec-common simpleec-common
COPY simpleec-core simpleec-core
COPY simpleec-channel simpleec-channel
COPY simpleec-api simpleec-api
RUN chmod +x gradlew && ./gradlew :simpleec-api:bootJar -x test --no-daemon

FROM eclipse-temurin:17-jre-alpine
WORKDIR /app
ADD https://github.com/open-telemetry/opentelemetry-java-instrumentation/releases/download/v2.10.0/opentelemetry-javaagent.jar /app/otel-agent.jar
COPY --from=builder /build/simpleec-api/build/libs/simpleec-api.jar app.jar
ENTRYPOINT ["java", "-javaagent:/app/otel-agent.jar", "-jar", "app.jar"]
